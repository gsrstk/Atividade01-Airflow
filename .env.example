# Imagem do Apache Airflow
AIRFLOW_IMAGE_NAME=apache/airflow:2.10.5-python3.12

# Banco de metadados do Airflow
AIRFLOW_DB_PASSWORD=senha_exemplo

# Chaves utilizadas pelo Airflow
# Gere uma chave Fernet válida antes de iniciar o ambiente.
FERNET_KEY=SUBSTITUA_POR_UMA_CHAVE_FERNET_VALIDA
AIRFLOW_SECRET_KEY=chave_secreta_exemplo

# Usuário administrador da interface Airflow
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=senha_exemplo

# Banco analítico da ShopBrasil
ANALYTICS_POSTGRES_USER=shopbrasil
ANALYTICS_POSTGRES_PASSWORD=senha_exemplo
ANALYTICS_POSTGRES_DB=shopbrasil

# UID utilizado pelos containers (em Windows, pode manter 50000)
AIRFLOW_UID=50000
